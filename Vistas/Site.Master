<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Vistas.SiteMaster" %>

<!DOCTYPE html>
<html lang="es-AR">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %></title>
    <link href="~/Estilos/estilos.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

    <form id="form1" runat="server">

        <header class="encabezado">
            <a class="marca" href="<%= ResolveUrl("~/Default.aspx") %>" aria-label="Ir al inicio">
                <span class="cruz" aria-hidden="true">+</span>
                <div>
                    <strong>Clínica San Rafael</strong>
                    <span>Sistema de gestión</span>
                </div>
            </a>

            <span class="separador"></span>

            <div class="usuario-chip">
                <span class="avatar"><%: Iniciales %></span>
                <span class="datos">
                    <b><%: NombreUsuario %></b>
                    <small><%: RolUsuario %></small>
                </span>
            </div>

            <a class="btn-salir" href="<%= ResolveUrl("~/Login.aspx?salir=1") %>">Cerrar sesión</a>
        </header>

        <div class="cuerpo">

            <aside class="menu">
                <div class="titulo">Menú principal</div>

                <% if (!EsMedico) { %>

                    <a class="<%= Activo("Default.aspx") %>" href="<%= ResolveUrl("~/Default.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h5v-6h4v6h5V9.5" /></svg>
                        </span>
                        Inicio
                    </a>

                    <a class="<%= Activo("Pacientes.aspx", "PacienteAlta.aspx", "PacienteModificar.aspx") %>" href="<%= ResolveUrl("~/Pacientes.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7" /></svg>
                        </span>
                        Pacientes
                    </a>

                    <a class="<%= Activo("Medicos.aspx", "MedicoAlta.aspx", "MedicoModificar.aspx") %>" href="<%= ResolveUrl("~/Medicos.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v6a5 5 0 0 0 10 0V3" /><path d="M7 3H5.5M17 3h1.5" /><path d="M12 14v3a4 4 0 0 0 8 0v-2" /><circle cx="20" cy="11.5" r="1.8" /></svg>
                        </span>
                        Médicos
                    </a>

                    <a class="<%= Activo("Turnos.aspx", "TurnoAsignar.aspx") %>" href="<%= ResolveUrl("~/Turnos.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>
                        </span>
                        Turnos
                    </a>

                    <a class="<%= Activo("Informes.aspx") %>" href="<%= ResolveUrl("~/Informes.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                        </span>
                        Informes
                    </a>

                <% } else { %>

                    <a class="<%= Activo("MisTurnos.aspx") %>" href="<%= ResolveUrl("~/MisTurnos.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>
                        </span>
                        Mis turnos
                    </a>

                    <a class="<%= Activo("MisPacientes.aspx") %>" href="<%= ResolveUrl("~/MisPacientes.aspx") %>">
                        <span class="ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7" /></svg>
                        </span>
                        Mis pacientes
                    </a>

                <% } %>

                <div class="titulo">Sesión</div>

                <a href="<%= ResolveUrl("~/Login.aspx?salir=1") %>">
                    <span class="ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4" /><path d="M15 8l4 4-4 4" /><path d="M19 12H9" /></svg>
                    </span>
                    Cerrar sesión
                </a>
            </aside>

            <main class="contenido">
                <asp:ContentPlaceHolder ID="Contenido" runat="server" />
            </main>

        </div>

    </form>

    <script>
        (function () {
            var velo = document.querySelector(".velo");

            if (!velo) {
                return;
            }

            var cancelar = velo.querySelector(".modal-pie .btn-secundario");

            if (cancelar) {
                cancelar.focus();
            }

            velo.addEventListener("click", function (e) {
                if (e.target === velo) {
                    window.location.href = window.location.pathname;
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    window.location.href = window.location.pathname;
                }
            });
        })();
    </script>

</body>
</html>
